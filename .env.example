# Octra Secret NFT - Environment Variables

# Pinata IPFS Configuration
# Get your keys at https://app.pinata.cloud/developers/api-keys
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_KEY=your_pinata_secret_key_here
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# Octra Contract Address (after deployment)
VITE_CONTRACT_ADDRESS=oct_secret_nft_contract_devnet

# Octra Devnet RPC (default)
VITE_OCTRA_RPC_URL=https://rpc.devnet.octra.org/rpc
