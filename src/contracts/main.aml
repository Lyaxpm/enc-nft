contract SecretMintNFT {

    state {
        name: string = "SecretMint NFT"
        symbol: string = "SMINT"
        owner: address
        total_supply: u64 = 0
        owners: map[string, address]
        token_uris: map[string, string]
        balances: map[address, u64]
        approvals: map[string, address]
        listings: map[string, u64]
    }

    constructor(deployer: address) {
        self.owner = deployer
    }

    event Mint(to: address, token_id: string, uri: string)
    event Transfer(from: address, to: address, token_id: string)
    event Approval(owner: address, approved: address, token_id: string)
    event Listed(token_id: string, price: u64)
    event Unlisted(token_id: string)
    event Sale(token_id: string, seller: address, buyer: address, price: u64)

    method mint(to: address, token_id: string, uri: string) {
        assert(!self.owners.contains(token_id), "token exists")
        self.owners[token_id] = to
        self.token_uris[token_id] = uri
        if self.balances.contains(to) {
            self.balances[to] = self.balances[to] + 1
        } else {
            self.balances[to] = 1
        }
        self.total_supply = self.total_supply + 1
        emit Mint(to, token_id, uri)
    }

    method transfer(from: address, to: address, token_id: string) {
        assert(self.owners[token_id] == caller || self.approvals[token_id] == caller, "not authorized")
        assert(self.owners[token_id] == from, "not owner")
        self.owners[token_id] = to
        self.balances[from] = self.balances[from] - 1
        if self.balances.contains(to) {
            self.balances[to] = self.balances[to] + 1
        } else {
            self.balances[to] = 1
        }
        if self.approvals.contains(token_id) {
            self.approvals.delete(token_id)
        }
        if self.listings.contains(token_id) {
            self.listings.delete(token_id)
        }
        emit Transfer(from, to, token_id)
    }

    method approve(to: address, token_id: string) {
        assert(self.owners[token_id] == caller, "not owner")
        self.approvals[token_id] = to
        emit Approval(caller, to, token_id)
    }

    method list_for_sale(token_id: string, price: u64) {
        assert(self.owners[token_id] == caller, "not owner")
        assert(price > 0, "price must be > 0")
        self.listings[token_id] = price
        emit Listed(token_id, price)
    }

    method unlist(token_id: string) {
        assert(self.owners[token_id] == caller, "not owner")
        assert(self.listings.contains(token_id), "not listed")
        self.listings.delete(token_id)
        emit Unlisted(token_id)
    }

    method buy(token_id: string) {
        assert(self.listings.contains(token_id), "not for sale")
        let price = self.listings[token_id]
        assert(value >= price, "insufficient payment")
        let seller = self.owners[token_id]
        assert(caller != seller, "cannot buy own token")
        self.owners[token_id] = caller
        self.balances[seller] = self.balances[seller] - 1
        if self.balances.contains(caller) {
            self.balances[caller] = self.balances[caller] + 1
        } else {
            self.balances[caller] = 1
        }
        if self.approvals.contains(token_id) {
            self.approvals.delete(token_id)
        }
        self.listings.delete(token_id)
        send(seller, price)
        emit Sale(token_id, seller, caller, price)
    }

    method owner_of(token_id: string) -> address {
        assert(self.owners.contains(token_id), "token does not exist")
        return self.owners[token_id]
    }

    method token_uri(token_id: string) -> string {
        assert(self.token_uris.contains(token_id), "token does not exist")
        return self.token_uris[token_id]
    }

    method balance_of(addr: address) -> u64 {
        if self.balances.contains(addr) {
            return self.balances[addr]
        }
        return 0
    }

    method get_name() -> string {
        return self.name
    }

    method get_symbol() -> string {
        return self.symbol
    }

    method get_total_supply() -> u64 {
        return self.total_supply
    }

    method get_listing_price(token_id: string) -> u64 {
        if self.listings.contains(token_id) {
            return self.listings[token_id]
        }
        return 0
    }

    method is_listed(token_id: string) -> u64 {
        if self.listings.contains(token_id) {
            return 1
        }
        return 0
    }
}
