contract SecretMintNFT {

  event Mint(token_id: int, to: address, uri: string)
  event Transfer(token_id: int, from: address, to: address)
  event Approval(token_id: int, owner: address, approved: address)
  event Listed(token_id: int, price: int, seller: address)
  event Unlisted(token_id: int, seller: address)
  event Sale(token_id: int, seller: address, buyer: address, price: int)

  const MAX_SUPPLY: int = 1000000

  state {
    name: string
    symbol: string
    owner: address
    total_supply: int

    owners: map[int]address
    token_uris: map[int]string
    balances: map[address]int
    approvals: map[int]address
    listings: map[int]int
    sellers: map[int]address

    treasury: int
  }

  constructor(n: string, s: string) {
    self.owner = origin
    self.name = n
    self.symbol = s
    self.total_supply = 0
    self.treasury = 0
  }

  fn mint(to: address, uri: string): int {
    require(caller == self.owner, "not owner")
    require(self.total_supply < MAX_SUPPLY, "max supply reached")
    let id = self.total_supply
    self.owners[id] = to
    self.token_uris[id] = uri
    self.balances[to] += 1
    self.total_supply += 1
    emit Mint(id, to, uri)
    return id
  }

  fn transfer_nft(token_id: int, to: address): bool {
    require(token_id >= 0, "invalid id")
    require(token_id < self.total_supply, "token not found")
    let from = self.owners[token_id]
    let approved = self.approvals[token_id]
    require(caller == from || caller == approved, "not authorized")
    self.owners[token_id] = to
    self.balances[from] -= 1
    self.balances[to] += 1
    self.approvals[token_id] = to
    if self.listings[token_id] > 0 {
      self.listings[token_id] = 0
      self.sellers[token_id] = to
    }
    emit Transfer(token_id, from, to)
    return true
  }

  fn approve(token_id: int, to: address): bool {
    require(token_id >= 0, "invalid id")
    require(token_id < self.total_supply, "token not found")
    require(caller == self.owners[token_id], "not owner")
    self.approvals[token_id] = to
    emit Approval(token_id, caller, to)
    return true
  }

  fn list_for_sale(token_id: int, price: int): bool {
    require(token_id >= 0, "invalid id")
    require(token_id < self.total_supply, "token not found")
    require(caller == self.owners[token_id], "not owner")
    require(price > 0, "price must be positive")
    self.listings[token_id] = price
    self.sellers[token_id] = caller
    emit Listed(token_id, price, caller)
    return true
  }

  fn unlist(token_id: int): bool {
    require(token_id >= 0, "invalid id")
    require(token_id < self.total_supply, "token not found")
    require(caller == self.owners[token_id], "not owner")
    require(self.listings[token_id] > 0, "not listed")
    self.listings[token_id] = 0
    emit Unlisted(token_id, caller)
    return true
  }

  fn buy(token_id: int): bool {
    require(token_id >= 0, "invalid id")
    require(token_id < self.total_supply, "token not found")
    let price = self.listings[token_id]
    require(price > 0, "not for sale")
    require(value >= price, "insufficient payment")
    let seller = self.owners[token_id]
    require(caller != seller, "cannot buy own token")
    self.owners[token_id] = caller
    self.balances[seller] -= 1
    self.balances[caller] += 1
    self.listings[token_id] = 0
    self.approvals[token_id] = caller
    self.treasury += value
    require(transfer(seller, price), "transfer failed")
    self.treasury -= price
    emit Sale(token_id, seller, caller, price)
    return true
  }

  view fn owner_of(token_id: int): address {
    require(token_id >= 0, "invalid id")
    require(token_id < self.total_supply, "token not found")
    return self.owners[token_id]
  }

  view fn token_uri(token_id: int): string {
    require(token_id >= 0, "invalid id")
    require(token_id < self.total_supply, "token not found")
    return self.token_uris[token_id]
  }

  view fn balance_of(addr: address): int {
    return self.balances[addr]
  }

  view fn get_name(): string {
    return self.name
  }

  view fn get_symbol(): string {
    return self.symbol
  }

  view fn get_total_supply(): int {
    return self.total_supply
  }

  view fn get_listing_price(token_id: int): int {
    return self.listings[token_id]
  }

  view fn is_listed(token_id: int): int {
    return self.listings[token_id]
  }

  view fn get_owner(): address {
    return self.owner
  }

  view fn get_approved(token_id: int): address {
    return self.approvals[token_id]
  }
}
