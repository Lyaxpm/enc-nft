// Octra Secret NFT Smart Contract
// Language: Applied (.aml) - Octra's smart contract language
// Standard: OCS-01-NFT (Non-Fungible Token extension of OCS-01)
//
// This contract manages Secret NFTs where encrypted content is stored
// in the metadata URI on IPFS. Only the token owner can decrypt the secret.

import interfaces/IOCS01NFT

// ============================================================
// STATE
// ============================================================

state {
    name: string = "Octra Secret NFT"
    symbol: string = "OSNFT"
    owner: address
    total_supply: u64 = 0
    
    // Mapping: token_id -> owner address
    owners: map[string, address]
    
    // Mapping: token_id -> metadata URI (IPFS hash)
    token_uris: map[string, string]
    
    // Mapping: owner address -> list of token IDs
    owned_tokens: map[address, list[string]]
    
    // Mapping: token_id -> approved address (for transfers)
    approvals: map[string, address]
}

// ============================================================
// CONSTRUCTOR
// ============================================================

constructor(deployer: address) {
    self.owner = deployer
}

// ============================================================
// MINT
// ============================================================

// Mint a new Secret NFT
// @param to: recipient address
// @param token_id: unique token identifier
// @param metadata_uri: IPFS URI containing encrypted metadata
method mint(to: address, token_id: string, metadata_uri: string) {
    // Ensure token doesn't already exist
    assert(!self.owners.contains(token_id), "Token already exists")
    
    // Set owner
    self.owners[token_id] = to
    
    // Set metadata URI
    self.token_uris[token_id] = metadata_uri
    
    // Add to owner's token list
    if (!self.owned_tokens.contains(to)) {
        self.owned_tokens[to] = []
    }
    self.owned_tokens[to].push(token_id)
    
    // Increment supply
    self.total_supply = self.total_supply + 1
    
    emit Mint(to, token_id, metadata_uri)
}

// ============================================================
// TRANSFER
// ============================================================

// Transfer an NFT to another address
method transfer(from: address, to: address, token_id: string) {
    // Verify caller is the owner or approved
    assert(
        self.owners[token_id] == caller || self.approvals[token_id] == caller,
        "Not authorized"
    )
    assert(self.owners[token_id] == from, "From is not the owner")
    
    // Update ownership
    self.owners[token_id] = to
    
    // Remove from sender's list
    self.owned_tokens[from].remove(token_id)
    
    // Add to receiver's list
    if (!self.owned_tokens.contains(to)) {
        self.owned_tokens[to] = []
    }
    self.owned_tokens[to].push(token_id)
    
    // Clear approval
    self.approvals.remove(token_id)
    
    emit Transfer(from, to, token_id)
}

// ============================================================
// APPROVE
// ============================================================

// Approve an address to transfer a specific token
method approve(approved: address, token_id: string) {
    assert(self.owners[token_id] == caller, "Not the owner")
    self.approvals[token_id] = approved
    emit Approval(caller, approved, token_id)
}

// ============================================================
// READ METHODS
// ============================================================

// Get the owner of a token
method owner_of(token_id: string) -> address {
    assert(self.owners.contains(token_id), "Token does not exist")
    return self.owners[token_id]
}

// Get the metadata URI for a token
method token_uri(token_id: string) -> string {
    assert(self.token_uris.contains(token_id), "Token does not exist")
    return self.token_uris[token_id]
}

// Get the number of tokens owned by an address
method balance_of(addr: address) -> u64 {
    if (!self.owned_tokens.contains(addr)) {
        return 0
    }
    return self.owned_tokens[addr].length()
}

// Get all token IDs owned by an address
method tokens_of(addr: address) -> list[string] {
    if (!self.owned_tokens.contains(addr)) {
        return []
    }
    return self.owned_tokens[addr]
}

// Get contract info
method get_name() -> string {
    return self.name
}

method get_symbol() -> string {
    return self.symbol
}

method get_total_supply() -> u64 {
    return self.total_supply
}

// ============================================================
// EVENTS
// ============================================================

event Mint(to: address, token_id: string, metadata_uri: string)
event Transfer(from: address, to: address, token_id: string)
event Approval(owner: address, approved: address, token_id: string)
