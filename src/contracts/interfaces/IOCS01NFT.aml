// OCS-01-NFT Interface Definition
// This file defines the interface for the SecretMint NFT contract
// Note: main.aml is self-contained and does not require this import

interface IOCS01NFT {
    method mint(to: address, token_id: string, uri: string)
    method transfer(from: address, to: address, token_id: string)
    method approve(to: address, token_id: string)
    method list_for_sale(token_id: string, price: u64)
    method unlist(token_id: string)
    method buy(token_id: string)
    method owner_of(token_id: string) -> address
    method token_uri(token_id: string) -> string
    method balance_of(addr: address) -> u64
    method get_name() -> string
    method get_symbol() -> string
    method get_total_supply() -> u64
    method get_listing_price(token_id: string) -> u64
    method is_listed(token_id: string) -> u64
}
